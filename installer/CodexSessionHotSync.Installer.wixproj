<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <OutputName>Codex会话热同步-Setup-1.3.0-x64</OutputName>
    <OutputPath>$(MSBuildThisFileDirectory)output\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</IntermediateOutputPath>
    <SuppressIces>ICE91</SuppressIces>
  </PropertyGroup>
</Project>
